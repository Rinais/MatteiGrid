# Mattei Grid - Environment Configuration Template
# Copy this file to .env (or configure in appsettings.Development.json / User Secrets)
# DO NOT COMMIT REAL PRODUCTION PASSWORDS OR SECRETS TO VERSION CONTROL

# Database (PostgreSQL)
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=matteigrid_db;Username=postgres;Password=your_local_db_password"

# JWT Authentication
Jwt__Key="replace_with_a_secure_minimum_32_character_random_secret_key_here!"
Jwt__Issuer="MatteiGridApi"
Jwt__Audience="MatteiGridClients"
Jwt__ExpiryMinutes=60
Jwt__RefreshTokenExpiryDays=7

# ASP.NET Core Runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS="http://localhost:5000"

# CORS Configuration (Frontend SPA origin)
Cors__AllowedOrigins="http://localhost:4200"

# Payment Gateway (Razorpay - Test Mode)
Razorpay__KeyId="rzp_test_placeholder_key_id"
Razorpay__KeySecret="placeholder_secret_key"
Razorpay__WebhookSecret="placeholder_webhook_secret"

# Notifications (Optional / SMS / Email)
Notifications__SmsApiKey=""
Notifications__SmtpHost="localhost"
Notifications__SmtpPort=25
Notifications__FromEmail="no-reply@matteigrid.local"
